# Publishable values only — never put secret / service-role keys in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Production API, e.g. https://api.yourdomain.com/api/v1 . Empty in dev = Expo host LAN IP :4000
EXPO_PUBLIC_API_URL=
